<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <title>Dashboard - Personal Finance Manager</title>

    <link rel="stylesheet" href="/style.css">

    <style>
        * {
            box-sizing: border-box;
            margin: 0;
            padding: 0;
            font-family: Arial, sans-serif;
        }

        body {
            background: #f5f7fb;
            color: #1f2937;
        }

        /* ================= NAVBAR ================= */

        .navbar {
            background: #111827;
            color: white;
            padding: 16px 5%;
            display: flex;
            justify-content: space-between;
            align-items: center;
            box-shadow: 0 3px 15px rgba(0, 0, 0, 0.15);
        }

        .logo {
            font-size: 21px;
            font-weight: bold;
        }

        .nav-links {
            display: flex;
            align-items: center;
            gap: 8px;
        }

        .nav-links a {
            color: #e5e7eb;
            text-decoration: none;
            padding: 9px 14px;
            border-radius: 7px;
            font-size: 14px;
            transition: 0.2s;
        }

        .nav-links a:hover {
            background: #374151;
            color: white;
        }

        .logout {
            background: #dc2626 !important;
            color: white !important;
        }

        .logout:hover {
            background: #b91c1c !important;
        }

        /* ================= MAIN ================= */

        .container {
            max-width: 1200px;
            margin: 35px auto;
            padding: 0 20px;
        }

        /* ================= WELCOME ================= */

        .welcome {
            margin-bottom: 28px;
        }

        .welcome h1 {
            font-size: 32px;
            margin-bottom: 7px;
            color: #111827;
        }

        .welcome p {
            color: #6b7280;
            font-size: 15px;
        }

        /* ================= SUMMARY CARDS ================= */

        .cards {
            display: grid;
            grid-template-columns: repeat(3, 1fr);
            gap: 20px;
            margin-bottom: 30px;
        }

        .card {
            background: white;
            padding: 24px;
            border-radius: 15px;
            box-shadow: 0 4px 18px rgba(0, 0, 0, 0.07);
            position: relative;
            overflow: hidden;
            transition: 0.2s;
        }

        .card:hover {
            transform: translateY(-3px);
            box-shadow: 0 7px 22px rgba(0, 0, 0, 0.10);
        }

        .card::after {
            content: "";
            position: absolute;
            width: 70px;
            height: 70px;
            right: -20px;
            top: -20px;
            border-radius: 50%;
            opacity: 0.08;
        }

        .card h3 {
            font-size: 14px;
            color: #6b7280;
            margin-bottom: 12px;
            font-weight: 600;
        }

        .card p {
            font-size: 28px;
            font-weight: bold;
        }

        .income {
            border-left: 5px solid #16a34a;
        }

        .income p {
            color: #16a34a;
        }

        .income::after {
            background: #16a34a;
        }

        .expense {
            border-left: 5px solid #dc2626;
        }

        .expense p {
            color: #dc2626;
        }

        .expense::after {
            background: #dc2626;
        }

        .balance {
            border-left: 5px solid #2563eb;
        }

        .balance p {
            color: #2563eb;
        }

        .balance::after {
            background: #2563eb;
        }

        /* ================= TRANSACTIONS ================= */

        .transactions {
            background: white;
            padding: 25px;
            border-radius: 15px;
            box-shadow: 0 4px 18px rgba(0, 0, 0, 0.07);
        }

        .transactions-header {
            display: flex;
            justify-content: space-between;
            align-items: center;
            gap: 15px;
            margin-bottom: 22px;
        }

        .transactions-header h2 {
            font-size: 21px;
            color: #111827;
        }

        .transaction-buttons {
            display: flex;
            gap: 8px;
            align-items: center;
            flex-wrap: wrap;
        }

        .transaction-buttons a {
            text-decoration: none;
            color: white;
            padding: 9px 13px;
            border-radius: 7px;
            font-size: 13px;
            font-weight: 600;
            transition: 0.2s;
        }

        .view-all-btn {
            background: #4b5563;
        }

        .view-all-btn:hover {
            background: #374151;
        }

        .income-btn {
            background: #16a34a;
        }

        .income-btn:hover {
            background: #15803d;
        }

        .expense-btn {
            background: #dc2626;
        }

        .expense-btn:hover {
            background: #b91c1c;
        }

        /* ================= FILTER ================= */

        .filter-bar {
            display: flex;
            gap: 10px;
            margin-bottom: 20px;
            padding: 15px;
            background: #f8fafc;
            border: 1px solid #e5e7eb;
            border-radius: 10px;
            flex-wrap: wrap;
        }

        .filter-bar input,
        .filter-bar select {
            padding: 10px 12px;
            border: 1px solid #d1d5db;
            border-radius: 7px;
            background: white;
            font-size: 13px;
            outline: none;
        }

        .filter-bar input {
            flex: 1;
            min-width: 200px;
        }

        .filter-bar input:focus,
        .filter-bar select:focus {
            border-color: #2563eb;
            box-shadow: 0 0 0 2px rgba(37, 99, 235, 0.10);
        }

        #clearFilters {
            border: none;
            background: #6b7280;
            color: white;
            padding: 10px 15px;
            border-radius: 7px;
            cursor: pointer;
            font-size: 13px;
        }

        #clearFilters:hover {
            background: #4b5563;
        }

        /* ================= TABLE ================= */

        .table-container {
            overflow-x: auto;
        }

        table {
            width: 100%;
            border-collapse: collapse;
            min-width: 700px;
        }

        th {
            background: #f3f4f6;
            color: #4b5563;
            text-align: left;
            padding: 13px;
            font-size: 13px;
            font-weight: 600;
            border-bottom: 1px solid #e5e7eb;
        }

        td {
            padding: 14px 13px;
            border-bottom: 1px solid #f0f0f0;
            font-size: 14px;
            color: #374151;
        }

        tbody tr {
            transition: 0.15s;
        }

        tbody tr:hover {
            background: #f9fafb;
        }

        /* ================= TYPE ================= */

        .income-text,
        .expense-text {
            display: inline-block;
            padding: 5px 9px;
            border-radius: 20px;
            font-size: 12px;
            font-weight: bold;
        }

        .income-text {
            color: #15803d;
            background: #dcfce7;
        }

        .expense-text {
            color: #b91c1c;
            background: #fee2e2;
        }

        /* ================= ACTION BUTTONS ================= */

        td a button {
            border: none;
            background: #2563eb;
            color: white;
            padding: 7px 10px;
            border-radius: 6px;
            cursor: pointer;
            font-size: 12px;
        }

        td a button:hover {
            background: #1d4ed8;
        }

        .delete-btn {
            border: none;
            background: #ef4444;
            color: white;
            padding: 7px 10px;
            border-radius: 6px;
            cursor: pointer;
            font-size: 12px;
            margin-left: 4px;
        }

        .delete-btn:hover {
            background: #dc2626;
        }

        /* ================= NO DATA ================= */

        .no-data {
            text-align: center;
            color: #6b7280;
            padding: 35px 10px;
            background: #f9fafb;
            border-radius: 8px;
        }

        /* ================= MOBILE ================= */

        @media (max-width: 768px) {

            .navbar {
                padding: 15px 20px;
                flex-direction: column;
                gap: 12px;
            }

            .nav-links {
                width: 100%;
                justify-content: center;
                flex-wrap: wrap;
            }

            .container {
                margin-top: 25px;
                padding: 0 15px;
            }

            .welcome h1 {
                font-size: 27px;
            }

            .cards {
                grid-template-columns: 1fr;
            }

            .transactions-header {
                align-items: flex-start;
                flex-direction: column;
            }

            .transaction-buttons {
                width: 100%;
            }

            .filter-bar {
                flex-direction: column;
            }

            .filter-bar input,
            .filter-bar select,
            #clearFilters {
                width: 100%;
            }

            .transactions {
                padding: 18px;
            }
        }
    </style>
</head>

<body>

    <!-- ================= NAVBAR ================= -->

    <div class="navbar">

        <div class="logo">
            💰 Personal Finance Manager
        </div>

        <div class="nav-links">
            <a href="/dashboard">Dashboard</a>
            <a href="/transaction">Add Transaction</a>
            <a href="/login" class="logout">Logout</a>
        </div>

    </div>


    <!-- ================= MAIN ================= -->

    <div class="container">

        <!-- Welcome -->

        <div class="welcome">

            <h1>Dashboard</h1>

            <p>
                Manage your income, expenses and financial activities.
            </p>

        </div>


        <!-- ================= FINANCIAL SUMMARY ================= -->

        <div class="cards">

            <!-- Income -->

            <div class="card income">

                <h3>Total Income</h3>

                <p>
                    ₹<%= Number(totalIncome).toFixed(2) %>
                </p>

            </div>


            <!-- Expense -->

            <div class="card expense">

                <h3>Total Expense</h3>

                <p>
                    ₹<%= Number(totalExpense).toFixed(2) %>
                </p>

            </div>


            <!-- Balance -->

            <div class="card balance">

                <h3>Current Balance</h3>

                <p>
                    ₹<%= Number(balance).toFixed(2) %>
                </p>

            </div>

        </div>


        <!-- ================= TRANSACTIONS ================= -->

        <div class="transactions">

            <div class="transactions-header">

                <h2>Recent Transactions</h2>

                <div class="transaction-buttons">

                    <a href="/transactions" class="view-all-btn">
                        View All
                    </a>

                    <a href="/income" class="income-btn">
                        + Income
                    </a>

                    <a href="/expense" class="expense-btn">
                        + Expense
                    </a>

                </div>

            </div>


            <!-- ================= FILTER ================= -->

            <div class="filter-bar">

                <input
                    type="text"
                    id="searchInput"
                    placeholder="🔍 Search transaction..."
                >

                <select id="typeFilter">

                    <option value="all">
                        All Types
                    </option>

                    <option value="income">
                        Income
                    </option>

                    <option value="expense">
                        Expense
                    </option>

                </select>


                <select id="categoryFilter">

                    <option value="all">
                        All Categories
                    </option>

                    <option value="Food">
                        Food
                    </option>

                    <option value="Shopping">
                        Shopping
                    </option>

                    <option value="Salary">
                        Salary
                    </option>

                    <option value="Rent">
                        Rent
                    </option>

                    <option value="Event">
                        Event
                    </option>

                    <option value="Entertainment">
                        Entertainment
                    </option>

                </select>


                <button type="button" id="clearFilters">
                    Clear
                </button>

            </div>


            <!-- ================= TABLE ================= -->

            <% if (recentTransactions.length === 0) { %>

                <p class="no-data">
                    No transactions yet.
                </p>

            <% } else { %>

                <div class="table-container">

                    <table id="transactionTable">

                        <thead>

                            <tr>

                                <th>Type</th>
                                <th>Amount</th>
                                <th>Category</th>
                                <th>Description</th>
                                <th>Action</th>
                                <th>Date</th>

                            </tr>

                        </thead>


                        <tbody>

                            <% recentTransactions.forEach(transaction => { %>

                                <tr>

                                    <!-- Type -->

                                    <td>

                                        <% if (transaction.type === "income") { %>

                                            <span class="income-text">
                                                Income
                                            </span>

                                        <% } else { %>

                                            <span class="expense-text">
                                                Expense
                                            </span>

                                        <% } %>

                                    </td>


                                    <!-- Amount -->

                                    <td>

                                        ₹<%= Number(transaction.amount).toFixed(2) %>

                                    </td>


                                    <!-- Category -->

                                    <td>

                                        <%= transaction.category %>

                                    </td>


                                    <!-- Description -->

                                    <td>

                                        <%= transaction.description || "-" %>

                                    </td>


                                    <!-- Action -->

                                    <td>

                                        <a href="/transaction/edit/<%= transaction.id %>">

                                            <button type="button">
                                                Edit
                                            </button>

                                        </a>


                                        <form
                                            action="/transaction/delete/<%= transaction.id %>"
                                            method="POST"
                                            class="delete-form"
                                            style="display:inline;"
                                        >

                                            <button
                                                type="submit"
                                                class="delete-btn"
                                            >
                                                Delete
                                            </button>

                                        </form>

                                    </td>


                                    <!-- Date -->

                                    <td>

                                        <%= new Date(transaction.transaction_date).toLocaleString("en-IN", {
                                            day: "2-digit",
                                            month: "short",
                                            year: "numeric"
                                        }) %>

                                    </td>

                                </tr>

                            <% }); %>

                        </tbody>

                    </table>

                </div>

            <% } %>

        </div>

    </div>


    <!-- ================= JAVASCRIPT ================= -->

    <script>

        /* Delete Confirmation */

        document.querySelectorAll(".delete-form").forEach(function(form) {

            form.addEventListener("submit", function(event) {

                const confirmed = confirm(
                    "Are you sure you want to delete this transaction?"
                );

                if (!confirmed) {
                    event.preventDefault();
                }

            });

        });


        /* Search and Filter */

        const searchInput =
            document.getElementById("searchInput");

        const typeFilter =
            document.getElementById("typeFilter");

        const categoryFilter =
            document.getElementById("categoryFilter");

        const clearFilters =
            document.getElementById("clearFilters");


        function filterTransactions() {

            const searchText =
                searchInput.value.toLowerCase();

            const selectedType =
                typeFilter.value.toLowerCase();

            const selectedCategory =
                categoryFilter.value.toLowerCase();


            const rows = document.querySelectorAll(
                "#transactionTable tbody tr"
            );


            rows.forEach(function(row) {

                const type =
                    row.cells[0].innerText.toLowerCase();

                const category =
                    row.cells[2].innerText.toLowerCase();

                const description =
                    row.cells[3].innerText.toLowerCase();


                const matchesSearch =
                    type.includes(searchText) ||
                    category.includes(searchText) ||
                    description.includes(searchText);


                const matchesType =
                    selectedType === "all" ||
                    type.includes(selectedType);


                const matchesCategory =
                    selectedCategory === "all" ||
                    category === selectedCategory;


                if (
                    matchesSearch &&
                    matchesType &&
                    matchesCategory
                ) {

                    row.style.display = "";

                } else {

                    row.style.display = "none";

                }

            });

        }


        searchInput.addEventListener(
            "input",
            filterTransactions
        );

        typeFilter.addEventListener(
            "change",
            filterTransactions
        );

        categoryFilter.addEventListener(
            "change",
            filterTransactions
        );


        clearFilters.addEventListener(
            "click",
            function() {

                searchInput.value = "";

                typeFilter.value = "all";

                categoryFilter.value = "all";

                filterTransactions();

            }
        );

    </script>

</body>

</html>