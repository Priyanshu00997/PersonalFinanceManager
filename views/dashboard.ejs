<!DOCTYPE html>
<html lang="en">

<head>
    <link rel="stylesheet" href="/style.css">
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <title>Dashboard - Personal Finance Manager</title>

    <style>
        * {
            box-sizing: border-box;
            margin: 0;
            padding: 0;
            font-family: Arial, sans-serif;
        }

        body {
            background: #f4f6f9;
            color: #222;
        }

        /* Navbar */
        .navbar {
            background: #1f2937;
            color: white;
            padding: 18px 40px;
            display: flex;
            justify-content: space-between;
            align-items: center;
        }

        .navbar h2 {
            font-size: 22px;
        }

        .navbar a {
            color: white;
            text-decoration: none;
            margin-left: 20px;
            padding: 9px 15px;
            border-radius: 6px;
        }

        .navbar a:hover {
            background: #374151;
        }

        .logout {
            background: #dc2626;
        }

        /* Main */
        .container {
            max-width: 1100px;
            margin: 40px auto;
            padding: 0 20px;
        }

        .welcome {
            margin-bottom: 30px;
        }

        .welcome h1 {
            font-size: 32px;
            margin-bottom: 8px;
        }

        .welcome p {
            color: #666;
        }

        /* Summary Cards */
        .cards {
            display: grid;
            grid-template-columns: repeat(3, 1fr);
            gap: 20px;
            margin-bottom: 35px;
        }

        .card {
            background: white;
            padding: 25px;
            border-radius: 12px;
            box-shadow: 0 3px 12px rgba(0, 0, 0, 0.08);
        }

        .card h3 {
            color: #666;
            font-size: 16px;
            margin-bottom: 12px;
        }

        .card p {
            font-size: 28px;
            font-weight: bold;
        }

        .income {
            border-left: 5px solid #16a34a;
        }

        .expense {
            border-left: 5px solid #dc2626;
        }

        .balance {
            border-left: 5px solid #2563eb;
        }

        /* Transactions */
        .transactions {
            background: white;
            padding: 25px;
            border-radius: 12px;
            box-shadow: 0 3px 12px rgba(0, 0, 0, 0.08);
        }

        .transactions-header {
            display: flex;
            justify-content: space-between;
            align-items: center;
            margin-bottom: 20px;
        }

        .transactions-header h2 {
            font-size: 22px;
        }

        .add-btn {
            background: #2563eb;
            color: white;
            padding: 10px 18px;
            text-decoration: none;
            border-radius: 6px;
        }

        .add-btn:hover {
            background: #1d4ed8;
        }

        table {
            width: 100%;
            border-collapse: collapse;
        }

        th {
            background: #f3f4f6;
            text-align: left;
            padding: 14px;
        }

        td {
            padding: 14px;
            border-bottom: 1px solid #eee;
        }

        .income-text {
            color: #16a34a;
            font-weight: bold;
        }

        .expense-text {
            color: #dc2626;
            font-weight: bold;
        }

        .no-data {
            color: #777;
            padding: 20px 0;
        }

        /* Mobile */
        @media (max-width: 768px) {

            .cards {
                grid-template-columns: 1fr;
            }

            .navbar {
                padding: 15px 20px;
            }

            .container {
                margin-top: 25px;
            }

            .transactions {
                overflow-x: auto;
            }

            table {
                min-width: 650px;
            }
        }
        .transaction-header {
            display: flex;
            justify-content: space-between;
            align-items: center;
            margin-bottom: 20px;
        }

        .transaction-header h2 {
            margin: 0;
        }

        .transaction-buttons {
            display: flex;
            gap: 10px;
            align-items: center;
        }

        .view-all-btn {
            background: #16a34a;
            color: white;
            padding: 10px 16px;
            text-decoration: none;
            border-radius: 6px;
            font-weight: 500;
        }

        .view-all-btn:hover {
            background: #15803d;
        }

        .add-btn {
            background: #2563eb;
            color: white;
            padding: 10px 16px;
            text-decoration: none;
            border-radius: 6px;
            font-weight: 500;
        }

        .add-btn:hover {
            background: #1d4ed8;
        }
    </style>
</head>

<body>

    <!-- Navbar -->
    <div class="navbar">

        <h2>💰 Personal Finance Manager</h2>

        <div>
            <a href="/dashboard">Dashboard</a>
            <a href="/transaction">Add Transaction</a>
            <a href="/login" class="logout">Logout</a>
        </div>

    </div>


    <!-- Main Container -->
    <div class="container">

        <!-- Welcome -->
        <div class="welcome">

            <h1>Dashboard</h1>

            <p>
                Manage your income, expenses and financial activities.
            </p>

        </div>


        <!-- Financial Summary -->
        <div class="cards">

            <!-- Income -->
            <div class="card income">

                <h3>Total Income</h3>

                <p>
                    ₹<%= Number(totalIncome).toFixed(2) %>
                </p>

            </div>


            <!-- Expense -->
            <div class="card expense">

                <h3>Total Expense</h3>

                <p>
                    ₹<%= Number(totalExpense).toFixed(2) %>
                </p>

            </div>


            <!-- Balance -->
            <div class="card balance">

                <h3>Current Balance</h3>

                <p>
                    ₹<%= Number(balance).toFixed(2) %>
                </p>

            </div>

        </div>


        <!-- Recent Transactions -->
        <div class="transaction-header">

            <h2>Recent Transactions</h2>

            <div class="transaction-buttons">
                <a href="/transactions" class="view-all-btn">
                    View All Transactions
                </a>

                <a href="/transaction" class="add-btn">
                    + Add Transaction
                </a>
            </div>
        </div>
            <!-- Search & Filter -->
            <div class="filter-bar">

                <input
                    type="text"
                    id="searchInput"
                    placeholder="Search transaction..."
                >

                <select id="typeFilter">
                    <option value="all">All Types</option>
                    <option value="income">Income</option>
                    <option value="expense">Expense</option>
                </select>

                <select id="categoryFilter">
                    <option value="all">All Categories</option>
                    <option value="Food">Food</option>
                    <option value="Shopping">Shopping</option>
                    <option value="Salary">Salary</option>
                    <option value="Rent">Rent</option>
                    <option value="Event">Event</option>
                    <option value="Entertainment">Entertainment</option>
                </select>

                <button type="button" id="clearFilters">
                    Clear
                </button>

            </div>


            <% if (recentTransactions.length === 0) { %>

                <p class="no-data">
                    No transactions yet.
                </p>

            <% } else { %>

                <table id="transactionTable">

                    <thead>

                        <tr>
                            <th>Type</th>
                            <th>Amount</th>
                            <th>Category</th>
                            <th>Description</th>
                            <th>Action</th>
                            <th>Date</th>
                        </tr>

                    </thead>

                    <tbody>

                        <% recentTransactions.forEach(transaction => { %>

                            <tr>

                                <td>

                                    <% if (transaction.type === "income") { %>

                                        <span class="income-text">
                                            Income
                                        </span>

                                    <% } else { %>

                                        <span class="expense-text">
                                            Expense
                                        </span>

                                    <% } %>

                                </td>


                                <td>
                                    ₹<%= Number(transaction.amount).toFixed(2) %>
                                </td>


                                <td>
                                    <%= transaction.category %>
                                </td>


                                <td>
                                    <%= transaction.description || "-" %>
                                </td>
                                <td>
                                    <a href="/transaction/edit/<%= transaction.id %>">
                                        <button type="button">Edit</button>
                                    </a>

                                    <form action="/transaction/delete/<%= transaction.id %>"
                                        method="POST"
                                        class="delete-form"
                                        style="display:inline;">

                                        <button type="submit" class="delete-btn">
                                            Delete
                                        </button>

                                    </form>
                                </td>
                                <td>
                                    <%= new Date(transaction.transaction_date).toLocaleString("en-IN", {
                                        day: "2-digit",
                                        month: "short",
                                        year: "numeric"
                                    }) %>
                                </td>

                            </tr>

                        <% }); %>

                    </tbody>

                </table>

            <% } %>

        </div>

    </div>

    <script>
        document.querySelectorAll(".delete-form").forEach(function(form) {

            form.addEventListener("submit", function(event) {

                const confirmed = confirm(
                    "Are you sure you want to delete this transaction?"
                );

                if (!confirmed) {
                    event.preventDefault();
                }

            });

        });
        // Search and Filter
        const searchInput = document.getElementById("searchInput");
        const typeFilter = document.getElementById("typeFilter");
        const categoryFilter = document.getElementById("categoryFilter");
        const clearFilters = document.getElementById("clearFilters");

        function filterTransactions() {

            const searchText = searchInput.value.toLowerCase();
            const selectedType = typeFilter.value.toLowerCase();
            const selectedCategory = categoryFilter.value.toLowerCase();

            const rows = document.querySelectorAll(
                "#transactionTable tbody tr"
            );

            rows.forEach(function(row) {

                const type = row.cells[0].innerText.toLowerCase();
                const category = row.cells[2].innerText.toLowerCase();
                const description = row.cells[3].innerText.toLowerCase();

                const matchesSearch =
                    type.includes(searchText) ||
                    category.includes(searchText) ||
                    description.includes(searchText);

                const matchesType =
                    selectedType === "all" ||
                    type.includes(selectedType);

                const matchesCategory =
                    selectedCategory === "all" ||
                    category === selectedCategory;

                if (
                    matchesSearch &&
                    matchesType &&
                    matchesCategory
                ) {
                    row.style.display = "";
                } else {
                    row.style.display = "none";
                }

            });
        }

        searchInput.addEventListener("input", filterTransactions);
        typeFilter.addEventListener("change", filterTransactions);
        categoryFilter.addEventListener("change", filterTransactions);

        clearFilters.addEventListener("click", function() {

            searchInput.value = "";
            typeFilter.value = "all";
            categoryFilter.value = "all";

            filterTransactions();

        });
    </script>

</body>

</html>