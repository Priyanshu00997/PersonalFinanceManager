<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <title>Dashboard - Personal Finance Manager</title>

    <style>
        * {
            box-sizing: border-box;
            margin: 0;
            padding: 0;
            font-family: Arial, sans-serif;
        }

        body {
            background: #f4f6f9;
            color: #222;
        }

        /* Navbar */
        .navbar {
            background: #1f2937;
            color: white;
            padding: 18px 40px;
            display: flex;
            justify-content: space-between;
            align-items: center;
        }

        .navbar h2 {
            font-size: 22px;
        }

        .navbar a {
            color: white;
            text-decoration: none;
            margin-left: 20px;
            padding: 9px 15px;
            border-radius: 6px;
        }

        .navbar a:hover {
            background: #374151;
        }

        .logout {
            background: #dc2626;
        }

        /* Main */
        .container {
            max-width: 1100px;
            margin: 40px auto;
            padding: 0 20px;
        }

        .welcome {
            margin-bottom: 30px;
        }

        .welcome h1 {
            font-size: 32px;
            margin-bottom: 8px;
        }

        .welcome p {
            color: #666;
        }

        /* Summary Cards */
        .cards {
            display: grid;
            grid-template-columns: repeat(3, 1fr);
            gap: 20px;
            margin-bottom: 35px;
        }

        .card {
            background: white;
            padding: 25px;
            border-radius: 12px;
            box-shadow: 0 3px 12px rgba(0, 0, 0, 0.08);
        }

        .card h3 {
            color: #666;
            font-size: 16px;
            margin-bottom: 12px;
        }

        .card p {
            font-size: 28px;
            font-weight: bold;
        }

        .income {
            border-left: 5px solid #16a34a;
        }

        .expense {
            border-left: 5px solid #dc2626;
        }

        .balance {
            border-left: 5px solid #2563eb;
        }

        /* Transactions */
        .transactions {
            background: white;
            padding: 25px;
            border-radius: 12px;
            box-shadow: 0 3px 12px rgba(0, 0, 0, 0.08);
        }

        .transactions-header {
            display: flex;
            justify-content: space-between;
            align-items: center;
            margin-bottom: 20px;
        }

        .transactions-header h2 {
            font-size: 22px;
        }

        .add-btn {
            background: #2563eb;
            color: white;
            padding: 10px 18px;
            text-decoration: none;
            border-radius: 6px;
        }

        .add-btn:hover {
            background: #1d4ed8;
        }

        table {
            width: 100%;
            border-collapse: collapse;
        }

        th {
            background: #f3f4f6;
            text-align: left;
            padding: 14px;
        }

        td {
            padding: 14px;
            border-bottom: 1px solid #eee;
        }

        .income-text {
            color: #16a34a;
            font-weight: bold;
        }

        .expense-text {
            color: #dc2626;
            font-weight: bold;
        }

        .no-data {
            color: #777;
            padding: 20px 0;
        }

        /* Mobile */
        @media (max-width: 768px) {

            .cards {
                grid-template-columns: 1fr;
            }

            .navbar {
                padding: 15px 20px;
            }

            .container {
                margin-top: 25px;
            }

            .transactions {
                overflow-x: auto;
            }

            table {
                min-width: 650px;
            }
        }
    </style>
</head>

<body>

    <!-- Navbar -->
    <div class="navbar">

        <h2>💰 Personal Finance Manager</h2>

        <div>
            <a href="/dashboard">Dashboard</a>
            <a href="/transaction">Add Transaction</a>
            <a href="/login" class="logout">Logout</a>
        </div>

    </div>


    <!-- Main Container -->
    <div class="container">

        <!-- Welcome -->
        <div class="welcome">

            <h1>Dashboard</h1>

            <p>
                Manage your income, expenses and financial activities.
            </p>

        </div>


        <!-- Financial Summary -->
        <div class="cards">

            <!-- Income -->
            <div class="card income">

                <h3>Total Income</h3>

                <p>
                    ₹<%= Number(totalIncome).toFixed(2) %>
                </p>

            </div>


            <!-- Expense -->
            <div class="card expense">

                <h3>Total Expense</h3>

                <p>
                    ₹<%= Number(totalExpense).toFixed(2) %>
                </p>

            </div>


            <!-- Balance -->
            <div class="card balance">

                <h3>Current Balance</h3>

                <p>
                    ₹<%= Number(balance).toFixed(2) %>
                </p>

            </div>

        </div>


        <!-- Recent Transactions -->
        <div class="transactions">

            <div class="transactions-header">

                <h2>Recent Transactions</h2>

                <a href="/transaction" class="add-btn">
                    + Add Transaction
                </a>

            </div>


            <% if (recentTransactions.length === 0) { %>

                <p class="no-data">
                    No transactions yet.
                </p>

            <% } else { %>

                <table>

                    <thead>

                        <tr>
                            <th>Type</th>
                            <th>Amount</th>
                            <th>Category</th>
                            <th>Description</th>
                            <th>Date</th>
                        </tr>

                    </thead>

                    <tbody>

                        <% recentTransactions.forEach(transaction => { %>

                            <tr>

                                <td>

                                    <% if (transaction.type === "income") { %>

                                        <span class="income-text">
                                            Income
                                        </span>

                                    <% } else { %>

                                        <span class="expense-text">
                                            Expense
                                        </span>

                                    <% } %>

                                </td>


                                <td>
                                    ₹<%= Number(transaction.amount).toFixed(2) %>
                                </td>


                                <td>
                                    <%= transaction.category %>
                                </td>


                                <td>
                                    <%= transaction.description || "-" %>
                                </td>


                                <td>
                                    <%= transaction.transaction_date %>
                                </td>

                            </tr>

                        <% }); %>

                    </tbody>

                </table>

            <% } %>

        </div>

    </div>

</body>

</html>