<!DOCTYPE html>
<html>

<head>

    <title>Shared Account</title>

    <link rel="stylesheet" href="/css/style.css">

    <style>

        body {
            font-family: Arial, sans-serif;
            background: #f5f7fb;
            margin: 0;
            padding: 40px;
        }

        .container {
            max-width: 700px;
            margin: auto;
        }

        h1 {
            text-align: center;
            margin-bottom: 30px;
        }

        .card {
            background: white;
            padding: 25px;
            margin-bottom: 25px;
            border-radius: 12px;
            box-shadow: 0 4px 15px rgba(0,0,0,0.08);
        }

        .card h2 {
            margin-top: 0;
        }

        input {
            width: 100%;
            padding: 12px;
            margin: 10px 0;
            box-sizing: border-box;
            border: 1px solid #ccc;
            border-radius: 6px;
        }

        button {
            width: 100%;
            padding: 12px;
            border: none;
            border-radius: 6px;
            background: #2563eb;
            color: white;
            font-size: 16px;
            cursor: pointer;
        }

        button:hover {
            background: #1d4ed8;
        }

        .account-info {
            background: #eef4ff;
            padding: 20px;
            border-radius: 8px;
            margin-top: 15px;
        }

        .invite-code {
            font-size: 28px;
            font-weight: bold;
            letter-spacing: 4px;
            text-align: center;
            margin: 15px 0;
        }

        .back {
            display: block;
            text-align: center;
            margin-top: 20px;
            text-decoration: none;
            color: #2563eb;
        }

    </style>

</head>

<body>

<div class="container">

    <h1>👫 Shared Account</h1>


    <% if (sharedAccount) { %>

        <div class="card">

            <h2>Your Shared Account</h2>

            <div class="account-info">

                <p>
                    <strong>Account Name:</strong>
                    <%= sharedAccount.account_name %>
                </p>

                <p>
                    <strong>Invite Code:</strong>
                </p>

                <div class="invite-code">
                    <%= sharedAccount.invite_code %>
                </div>

                <p>
                    Share this code with your partner so they
                    can join this account.
                </p>

            </div>

        </div>


    <% } else { %>

        <div class="card">

            <h2>➕ Create Shared Account</h2>

            <form action="/shared-account/create" method="POST">

                <input
                    type="text"
                    name="account_name"
                    placeholder="Account name"
                    required
                >

                <button type="submit">
                    Create Shared Account
                </button>

            </form>

        </div>


        <div class="card">

            <h2>🔗 Join Shared Account</h2>

            <form action="/shared-account/join" method="POST">

                <input
                    type="text"
                    name="invite_code"
                    placeholder="Enter 6-digit invite code"
                    maxlength="6"
                    required
                >

                <button type="submit">
                    Join Shared Account
                </button>

            </form>

        </div>

    <% } %>


    <a href="/dashboard" class="back">
        ← Back to Dashboard
    </a>

</div>

</body>

</html>